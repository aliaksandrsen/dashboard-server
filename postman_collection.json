            "body": {
              "mode": "raw",
              "raw": "{\n  \"total\": 350.00,\n  \"userId\": 1,\n  \"productIds\": [\n    \"34d05e33-a69e-410c-8ad1-6bb3481711d1\",\n    \"9eea332a-8c1b-4a0c-bee1-c97ba80f3308\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            },
            "description": "Create a new order for a user with products"
          },
          "response": []
        },
        {
          "name": "Update Order (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"total\": 249.99,\n  \"userId\": 1,\n  \"productIds\": [\n    \"34d05e33-a69e-410c-8ad1-6bb3481711d1\",\n    \"9eea332a-8c1b-4a0c-bee1-c97ba80f3308\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}"]
            },
            "description": "Partially update an order (total, user, or replace product list)"
          },
          "response": []
        },
        {
          "name": "Delete Order",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}"]
            },
            "description": "Delete an existing order by ID"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Stripe",
      "item": [
        {
          "name": "Create Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}",
                "description": "Origin header for redirect URLs"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priceId\": \"price_1Nxxxxxxxxxxxxxxxxxxxx\",\n  \"quantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/stripe/payments",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "stripe", "payments"]
            },
            "description": "Create a Stripe Checkout session for payment"
          },
          "response": []
        }
      ]
    }
  ]
